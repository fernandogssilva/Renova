<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         CURUPIRA · Tema Claro
         Mesmos papeis semanticos do tema escuro, contraste invertido.
         Verde = protecao | Laranja fogo = acao | Vermelho = risco
         ============================================================ -->

    <Color x:Key="Bg0">#F3FAF6</Color>
    <Color x:Key="Bg1">#FFFFFF</Color>
    <Color x:Key="Bg2">#E7F4EC</Color>
    <Color x:Key="Bg3">#C9E3D5</Color>

    <Color x:Key="Fg0">#082016</Color>
    <Color x:Key="Fg1">#153427</Color>
    <Color x:Key="Fg2">#456357</Color>
    <Color x:Key="Fg3">#6E8D7E</Color>

    <!-- Tons mais escuros para manter contraste AA sobre fundo claro -->
    <Color x:Key="Accent">#047857</Color>
    <Color x:Key="AccentAlt">#C2410C</Color>

    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="Danger">#B91C1C</Color>
    <Color x:Key="Critical">#991B1B</Color>

    <Color x:Key="LogBg">#082016</Color>

    <SolidColorBrush x:Key="Bg0Brush"        Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush"        Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush"        Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush"        Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="Fg0Brush"        Color="{StaticResource Fg0}"/>
    <SolidColorBrush x:Key="Fg1Brush"        Color="{StaticResource Fg1}"/>
    <SolidColorBrush x:Key="Fg2Brush"        Color="{StaticResource Fg2}"/>
    <SolidColorBrush x:Key="Fg3Brush"        Color="{StaticResource Fg3}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentAltBrush"  Color="{StaticResource AccentAlt}"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush"    Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="CriticalBrush"   Color="{StaticResource Critical}"/>
    <SolidColorBrush x:Key="LogBgBrush"      Color="{StaticResource LogBg}"/>

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#047857" Offset="0"/>
        <GradientStop Color="#C2410C" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
