<Window x:Class="Renova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Renova.ViewModels"
        xmlns:conv="clr-namespace:Renova.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Renova — Manutenção, desempenho e segurança"
        Icon="Assets/Renova.ico"
        Height="860" Width="1420"
        MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="B2V"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:MegabytesFormatConverter x:Key="MbFmt"/>
        <conv:IndexToBoolConverter x:Key="Idx"/>
        <conv:HexToBrushConverter x:Key="Hex2B"/>
        <conv:CountToVisibilityConverter x:Key="Cnt2V"/>
        <conv:ScoreToArcConverter x:Key="Arc"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
                                  ÁREA PRINCIPAL
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 header  -->
                <RowDefinition Height="Auto"/>   <!-- 1 progress-->
                <RowDefinition Height="Auto"/>   <!-- 2 KPIs    -->
                <RowDefinition Height="*"/>      <!-- 3 conteúdo-->
                <RowDefinition Height="Auto"/>   <!-- 4 rodapé  -->
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" Padding="22,16" Background="{DynamicResource Bg1Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Indicador de atividade -->
                    <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0">
                        <Ellipse Width="46" Height="46" Stroke="{DynamicResource Bg2Brush}" StrokeThickness="4"/>

                        <Grid Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinT" Angle="0"/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Grid.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinT"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.9"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Path StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 23 2 A 21 21 0 1 1 4 31"
                                  Stroke="{DynamicResource BrandGradient}"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0"/>
                        </Grid>

                        <Path Data="M 13 23 L 21 31 L 33 17" Stroke="{DynamicResource SuccessBrush}"
                              StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Visibility="{Binding IsBusy, Converter={StaticResource B2V}, ConverterParameter=inv}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RENOVA" FontSize="23" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg0Brush}" Margin="0,0,10,0"/>
                            <TextBlock Text="seu Windows em dia" FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                   Foreground="{DynamicResource Fg2Brush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Executar tudo" Style="{StaticResource FireButton}"
                                Command="{Binding RunFullMaintenanceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Atualizar" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshAllCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                                Margin="0,0,8,0"/>
                        <Button Content="Cancelar" Style="{StaticResource DangerButton}"
                                Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" Height="4" Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Minimum="0"/>

            <!-- ================= KPIs ================= -->
            <Grid Grid.Row="2" Margin="18,16,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Vulnerabilidades" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CriticalVulnCount}" Style="{StaticResource CardValue}"
                                       Foreground="{DynamicResource CriticalBrush}"/>
                            <TextBlock Text="{Binding TotalVulnCount, StringFormat=' / {0}'}"
                                       Style="{StaticResource CardValue}" FontSize="17"
                                       VerticalAlignment="Bottom" Foreground="{DynamicResource Fg3Brush}"/>
                        </StackPanel>
                        <TextBlock Text="críticas / total" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Windows Update" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding PendingWindowsUpdates}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding PendingSecurityUpdates, StringFormat='{}{0} de segurança'}"
                                   Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Aplicativos" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding PendingApps}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="com update disponível" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Disco recuperável" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalCleanableMB, Converter={StaticResource MbFmt}}"
                                   Style="{StaticResource CardValue}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding LastCleanupText, StringFormat='última: {0}'}"
                                   Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Memória RAM" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding MemoryLoadPercent, StringFormat='{}{0}%'}"
                                   Style="{StaticResource CardValue}"
                                   Foreground="{DynamicResource AccentAltBrush}"/>
                        <TextBlock Text="{Binding MemoryStatusText}" Style="{StaticResource CardCaption}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= CONTEÚDO ================= -->
            <TabControl Grid.Row="3" Margin="18,16,18,0" SelectedIndex="{Binding SelectedSection}"
                        Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 0 · PAINEL -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ===== Pontuação de saúde ===== -->
                            <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Anel de pontuação -->
                                    <Grid Grid.Column="0" Width="140" Height="140" Margin="0,0,26,0">
                                        <Ellipse Width="120" Height="120" Stroke="{DynamicResource Bg2Brush}" StrokeThickness="10"/>
                                        <Path StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding HealthColor, Converter={StaticResource Hex2B}}"
                                              Data="{Binding HealthScore, Converter={StaticResource Arc}, ConverterParameter='70,70,60'}"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding HealthScore}" FontSize="42" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding HealthColor, Converter={StaticResource Hex2B}}"/>
                                            <TextBlock Text="de 100" FontSize="10.5" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fg3Brush}" Margin="0,-6,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Saúde do sistema" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding HealthLabel}" FontSize="29" FontWeight="Bold"
                                                   Foreground="{Binding HealthColor, Converter={StaticResource Hex2B}}"
                                                   Margin="0,2,0,6"/>
                                        <TextBlock Text="{Binding HealthSummary}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Fg2Brush}" LineHeight="20" MaxWidth="620"/>
                                        <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource Fg3Brush}">
                                            <Run Text="A pontuação combina vulnerabilidades, atualizações pendentes, espaço em disco, memória, inicialização e fragmentação."/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="160">
                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AreasNeedingAction}" FontSize="30" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentAltBrush}"/>
                                                <TextBlock Text="áreas precisam de ação" FontSize="10.5" TextAlignment="Center"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Fg3Brush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Corrigir tudo" Style="{StaticResource FireButton}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding RunFullMaintenanceCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="O que foi analisado" Style="{StaticResource SectionTitle}" Margin="2,6,0,2"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}" Margin="2,0,0,12"
                                       Text="Cada área abaixo mostra o que foi encontrado, o que aquilo significa e o que muda no computador depois de resolver."/>

                            <!-- ===== Cards explicativos ===== -->
                            <ItemsControl ItemsSource="{Binding DashboardItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,9" Padding="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Faixa de estado -->
                                                <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                                           Margin="0,0,16,0"
                                                           Fill="{Binding LevelColor, Converter={StaticResource Hex2B}}"/>

                                                <!-- Número + área -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding LevelColor, Converter={StaticResource Hex2B}}"/>
                                                        <TextBlock Text="{Binding Area}" Style="{StaticResource CardTitle}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontSize="27" FontWeight="Bold"
                                                               Foreground="{DynamicResource Fg0Brush}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ValueCaption}" Style="{StaticResource CardCaption}"/>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="10.5" FontWeight="SemiBold"
                                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Foreground="{Binding LevelColor, Converter={StaticResource Hex2B}}"/>
                                                </StackPanel>

                                                <!-- Explicações -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="O QUE É" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding WhatItIs}" FontSize="12.5" TextWrapping="Wrap"
                                                               LineHeight="19" Foreground="{DynamicResource Fg2Brush}"
                                                               Margin="0,0,0,11"/>

                                                    <TextBlock Text="O QUE MELHORA NO COMPUTADOR" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding WhatItImproves}" FontSize="12.5" TextWrapping="Wrap"
                                                               LineHeight="19" Foreground="{DynamicResource Fg1Brush}"/>
                                                </StackPanel>

                                                <!-- Ação -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="128">
                                                    <Button Content="{Binding ActionLabel}" HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding TargetSection}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsAction}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentAltBrush}"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Estado vazio -->
                            <Border Style="{StaticResource CardBorder}" Padding="30"
                                    Visibility="{Binding AreasNeedingAction, Converter={StaticResource Cnt2V}, ConverterParameter=inv}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Nenhuma varredura executada ainda" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="Clique em Atualizar no topo para analisar o sistema."
                                               FontSize="12" Margin="0,6,0,14" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                    <Button Content="Analisar agora" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Center" Command="{Binding RefreshAllCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 1 · VULNERABILIDADES -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Vulnerabilidades" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}"
                                       Text="CVEs da Microsoft (MSRC) e falhas de configuração local. Marque várias e corrija de uma vez."/>
                        </StackPanel>

                        <!-- Barra de seleção em lote -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Todas" Style="{StaticResource ChipButton}"
                                            Command="{Binding SelectAllVulnsCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Só críticas" Style="{StaticResource ChipButton}"
                                            Command="{Binding SelectCriticalVulnsCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Corrigíveis automaticamente" Style="{StaticResource ChipButton}"
                                            Command="{Binding SelectAutoFixableVulnsCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Limpar" Style="{StaticResource ChipButton}"
                                            Command="{Binding ClearVulnSelectionCommand}" Margin="0,0,14,0"/>
                                    <CheckBox VerticalAlignment="Center" FontSize="11.5"
                                              Foreground="{DynamicResource Fg2Brush}"
                                              IsChecked="{Binding ShowLikelyPatchedVulns}"
                                              ToolTip="A cumulativa instalada provavelmente já corrigiu essas CVEs, mas não é garantia: patches out-of-band e componentes fora da cumulativa (.NET, Edge, Office, Defender) escapam.">
                                        <TextBlock>
                                            <Run Text="Mostrar as"/>
                                            <Run Text="{Binding VulnLikelyPatchedCount, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="prováveis já corrigidas"/>
                                        </TextBlock>
                                    </CheckBox>
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                           Foreground="{DynamicResource Fg2Brush}" FontSize="12.5">
                                    <Run Text="{Binding SelectedVulnCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="selecionada(s) de"/>
                                    <Run Text="{Binding TotalVulnCount, Mode=OneWay}"/>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Varrer novamente" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RunVulnScanCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource FireButton}"
                                            Command="{Binding ApplySelectedPatchesCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                        <TextBlock>
                                            <Run Text="Corrigir selecionadas ("/><Run Text="{Binding SelectedVulnCount, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Distribuição por severidade -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Distribuição por severidade" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="(apenas as pendentes)" FontSize="10.5" Margin="7,1,0,0"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                </StackPanel>

                                <UniformGrid Rows="1" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SevCritical}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource CriticalBrush}"/>
                                        <TextBlock Text="Críticas" Style="{StaticResource CardCaption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SevImportant}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="Importantes" Style="{StaticResource CardCaption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SevModerate}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="Moderadas" Style="{StaticResource CardCaption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SevLow}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Baixas" Style="{StaticResource CardCaption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SevInformational}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource Fg2Brush}"/>
                                        <TextBlock Text="Informativas" Style="{StaticResource CardCaption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding VulnNoPatchCount}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentAltBrush}"/>
                                        <TextBlock Text="Sem patch" Style="{StaticResource CardCaption}"
                                                   ToolTip="Mitigação, workaround ou falha ainda sem correção publicada pela Microsoft."/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding VulnScanStatus}" Margin="0,10,0,0"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg3Brush}"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="3" Style="{StaticResource DataGridBase}"
                                  ItemsSource="{Binding Vulnerabilities}" IsReadOnly="False"
                                  SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="✓" FontSize="12"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Severidade" Width="108" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource CriticalBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Important">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Moderate">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Informational">
                                                                <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SeverityLabel}" Foreground="White"
                                                           FontWeight="SemiBold" FontSize="10.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Status" Width="118" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontSize="10.5"
                                                       FontWeight="SemiBold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Pendente"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LikelyPatched}" Value="True">
                                                                <Setter Property="Text" Value="Provável já corrigida"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CVSS" Binding="{Binding CvssScore, StringFormat={}{0:N1}}" Width="58" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Identificador" Binding="{Binding Cve}" Width="145" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Correção" Binding="{Binding Kb}" Width="210" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Estado" Width="100" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding StateColor, Converter={StaticResource Hex2B}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Ações" Width="215" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Corrigir" Style="{StaticResource PrimaryButton}"
                                                        Padding="9,4" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.ApplyPatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="MSRC" Style="{StaticResource ChipButton}" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenCatalogUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding MsrcUrl}"/>
                                                <Button Content="Catálogo" Style="{StaticResource ChipButton}"
                                                        Command="{Binding DataContext.OpenCatalogUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding CatalogUrl}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 2 · WINDOWS UPDATE -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Windows Update" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Atualizações do sistema pendentes, incluindo pacotes de segurança."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Instalar todas" Style="{StaticResource FireButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding InstallWindowsUpdatesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        <DataGrid Grid.Row="2" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding WindowsUpdates}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KB" Binding="{Binding Kb}" Width="115"/>
                                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="215"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeMB, StringFormat={}{0:N1} MB}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 3 · CATÁLOGO MICROSOFT -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Catálogo oficial da Microsoft" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Compara a build instalada com a última publicada no release-health da Microsoft."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Consultar agora" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CheckMicrosoftCatalogCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                            <Button Content="Instalar pendentes" Style="{StaticResource FireButton}"
                                    Command="{Binding InstallWindowsUpdatesCommand}"
                                    IsEnabled="{Binding CatalogHasPending}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Margin="2,0,0,10" FontSize="12" Foreground="{DynamicResource Fg2Brush}">
                            <Run Text="Local:"/><Run Text="{Binding CurrentOsBuild, Mode=OneWay}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="Oficial:"/><Run Text="{Binding LatestOfficialKb, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="(build"/><Run Text="{Binding LatestOfficialBuild, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <DataGrid Grid.Row="3" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding CatalogPending}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="KB" Binding="{Binding Kb}" Width="120"/>
                                <DataGridTextColumn Header="Build" Binding="{Binding BuildString}" Width="120"/>
                                <DataGridTextColumn Header="Publicado" Binding="{Binding PublishedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                <DataGridTemplateColumn Header="Microsoft Update Catalog" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Abrir no site da Microsoft" Style="{StaticResource ChipButton}"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenCatalogUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding CatalogUrl}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 4 · LIMPEZA DE DISCO -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Limpeza de disco" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Temporários, caches de desenvolvimento e navegador, e o Disk Cleanup do Windows."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Executar limpeza" Style="{StaticResource FireButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding RunCleanupCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        <DataGrid Grid.Row="2" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding Cleanables}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="230"/>
                                <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeMB, StringFormat={}{0:N1} MB}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 5 · MEMÓRIA RAM -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Memória RAM" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Compacta o working set dos processos e descarta a standby list, devolvendo memória ao sistema."
                                       Style="{StaticResource SectionSubtitle}"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Uso atual" Style="{StaticResource CardTitle}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MemoryLoadPercent, StringFormat='{}{0}%'}"
                                                           Style="{StaticResource CardValue}" FontSize="38"
                                                           Foreground="{DynamicResource AccentAltBrush}"/>
                                                <TextBlock Text="{Binding MemoryStatusText}" Style="{StaticResource CardCaption}"
                                                           FontSize="13" VerticalAlignment="Bottom" Margin="12,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Atualizar leitura" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding RefreshMemoryCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Liberar memória agora" Style="{StaticResource FireButton}"
                                                    Command="{Binding CleanMemoryCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar Value="{Binding MemoryLoadPercent, Mode=OneWay}" Maximum="100" Height="10"
                                                 Foreground="{DynamicResource AccentAltBrush}"/>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CardCaption}"
                                               Visibility="{Binding LastMemoryFreedMB, Converter={StaticResource Cnt2V}}">
                                        <Run Text="Última liberação:"/>
                                        <Run Text="{Binding LastMemoryFreedMB, StringFormat={}{0:N0} MB, Mode=OneWay}"
                                             FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ===== Aplicativos consumindo memória ===== -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Aplicativos consumindo memória" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource CardCaption}" Margin="0,2,0,0">
                                                <Run Text="Somados por aplicativo —"/>
                                                <Run Text="{Binding TopProcessesTotalMB, StringFormat={}{0:N0} MB, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text="no total. Compactar libera memória sem fechar; encerrar fecha o aplicativo."/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Atualizar lista" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Top"
                                                Command="{Binding RefreshProcessesCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding TopProcesses}" Style="{StaticResource DataGridBase}"
                                              IsReadOnly="True" MaxHeight="420" Margin="0,10,0,0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Aplicativo" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Display}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Fg0Brush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource Fg3Brush}">
                                                                <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Origin, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Memória" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MemoryMB, StringFormat={}{0:N0} MB}"
                                                                       FontSize="13.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentAltBrush}"/>
                                                            <TextBlock Text="{Binding ProtectedNote}" FontSize="10"
                                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Ações" Width="215">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Compactar" Style="{StaticResource ChipButton}" Margin="0,0,5,0"
                                                                    ToolTip="Devolve memória sem fechar o aplicativo"
                                                                    Command="{Binding DataContext.TrimProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Encerrar" Padding="10,4" FontSize="11"
                                                                    IsEnabled="{Binding CanClose}"
                                                                    ToolTip="Fecha o aplicativo e devolve toda a memória"
                                                                    Command="{Binding DataContext.CloseProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanClose}" Value="False">
                                                                                <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Como funciona — e quando ajuda de verdade"
                                               Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CardCaption}" FontSize="12" LineHeight="19" TextWrapping="Wrap">
                                        O Windows já gerencia memória bem sozinho — esta função não "cria" RAM.
                                        O que ela faz: (1) compacta o working set de cada processo, devolvendo páginas
                                        que ficaram retidas; (2) descarta a standby list, que é cache de arquivos já
                                        gravado em disco, convertendo "em espera" em memória livre de verdade.
                                        <LineBreak/><LineBreak/>
                                        O ganho é perceptível depois de fechar aplicativos pesados (IDE, máquina virtual,
                                        navegador com muitas abas) ou antes de abrir algo que precisa de bastante memória.
                                        Como efeito colateral, os próximos acessos a arquivos ficam mais lentos até o cache
                                        reaquecer — por isso não vale executar de minuto em minuto.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 6 · DISCOS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Discos" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Fragmentação por unidade. SSDs recebem TRIM; HDDs recebem desfragmentação."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Otimizar unidades" Style="{StaticResource FireButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding DefragAllCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        <DataGrid Grid.Row="2" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding Drives}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Unidade" Binding="{Binding Drive}" Width="100"/>
                                <DataGridTextColumn Header="Fragmentação" Binding="{Binding FragmentationPercent, StringFormat={}{0:N0}%}" Width="150"/>
                                <DataGridTextColumn Header="Última otimização" Binding="{Binding LastDefrag, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 7 · INICIALIZAÇÃO -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Inicialização" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Programas que sobem junto com o Windows. Desativar os desnecessários acelera o boot."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding StartupApps}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="240"/>
                                <DataGridTextColumn Header="Origem" Binding="{Binding Location}" Width="160"/>
                                <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Enabled}" Width="70"/>
                                <DataGridTemplateColumn Header="Ação" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Alternar" Style="{StaticResource ChipButton}"
                                                    Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 8 · APLICATIVOS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Aplicativos" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Programas com versão mais nova disponível via winget."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Atualizar todos" Style="{StaticResource FireButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding UpgradeAppsCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        <DataGrid Grid.Row="2" Style="{StaticResource DataGridBase}" IsReadOnly="True"
                                  ItemsSource="{Binding WingetUpdates}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Identificador" Binding="{Binding Id}" Width="250"/>
                                <DataGridTextColumn Header="Atual" Binding="{Binding CurrentVersion}" Width="130"/>
                                <DataGridTextColumn Header="Disponível" Binding="{Binding AvailableVersion}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 9 · VARREDURA AO VIVO -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Varredura ao vivo" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Cada módulo mostrando o que está analisando e o que encontrou, em tempo real."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanReports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Ellipse Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                                         Width="12" Height="12" Margin="0,4,14,0" VerticalAlignment="Top"
                                                         Fill="{Binding StateColor, Converter={StaticResource Hex2B}}"/>

                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Fg0Brush}"/>
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" Margin="10,3,0,0"
                                                               Foreground="{DynamicResource Fg3Brush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FoundCount}" FontSize="22" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="itens" FontSize="10.5" Margin="5,0,0,3"
                                                               VerticalAlignment="Bottom" Foreground="{DynamicResource Fg3Brush}"/>
                                                </StackPanel>

                                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4"
                                                             Margin="0,8,0,4" Maximum="100"
                                                             Value="{Binding Progress, Mode=OneWay}"/>

                                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding CurrentActivity}" FontSize="12"
                                                               Foreground="{DynamicResource Fg2Brush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Fg3Brush}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Último:" FontStyle="Italic"/><Run Text="{Binding LastFoundItem, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ActionHint}" FontSize="11.5" FontWeight="SemiBold"
                                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- 10 - REGRAS DA COMUNIDADE (winapp2) -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Regras da comunidade" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}"
                                       Text="Base winapp2.ini — milhares de regras de limpeza mantidas pela comunidade há mais de 15 anos, cobrindo aplicativos que nenhum limpador genérico conhece. O CCleaner abandonou esse formato na versão 7."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Todas" Style="{StaticResource ChipButton}"
                                            Command="{Binding SelectAllWinapp2Command}" Margin="0,0,6,0"/>
                                    <Button Content="Limpar seleção" Style="{StaticResource ChipButton}"
                                            Command="{Binding ClearWinapp2SelectionCommand}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                           FontSize="12.5" Foreground="{DynamicResource Fg2Brush}">
                                    <Run Text="{Binding Winapp2SelectedCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="selecionados ·"/>
                                    <Run Text="{Binding Winapp2TotalMB, StringFormat={}{0:N1} MB, Mode=OneWay}" FontWeight="Bold"
                                         Foreground="{DynamicResource AccentBrush}"/>
                                    <Run Text="no total ·"/>
                                    <Run Text="{Binding Winapp2DatabaseStatus, Mode=OneWay}"/>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Baixar / atualizar base" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DownloadWinapp2Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                                    <Button Content="Analisar" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ScanWinapp2Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                                    <Button Content="Limpar selecionados" Style="{StaticResource FireButton}"
                                            Command="{Binding CleanWinapp2Command}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding Winapp2Status}" Margin="2,0,0,8"
                                   FontSize="11.5" Foreground="{DynamicResource Fg3Brush}"/>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding Winapp2Results}"
                                  Style="{StaticResource DataGridBase}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42" CanUserSort="False">
                                    <DataGridTemplateColumn.Header><TextBlock Text="✓" FontSize="12"/></DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Alvo" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="170" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Arquivos" Binding="{Binding FileCount, StringFormat={}{0:N0}}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Aviso" Width="70" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="⚠" FontSize="14" HorizontalAlignment="Center"
                                                       ToolTip="{Binding Warning}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource B2V}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 11 - REGISTRO -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Registro do Windows" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}"
                                       Text="Entradas órfãs deixadas por programas desinstalados. Todo backup é feito antes de qualquer remoção."/>
                        </StackPanel>

                        <!-- Aviso honesto -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Leia antes de usar" Style="{StaticResource CardTitle}"
                                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Fg2Brush}">
                                    <Run Text="Limpar registro NÃO acelera o Windows." FontWeight="Bold"/>
                                    <Run Text="O registro tem milhões de chaves e fica indexado em memória — remover algumas centenas não muda tempo de boot nem uso de RAM. Quem promete ganho de desempenho aqui está vendendo ilusão."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="O ganho real é de higiene e, num caso específico, de segurança:"/>
                                    <Run Text="regras de firewall apontando para programas que já não existem" FontWeight="SemiBold"
                                         Foreground="{DynamicResource DangerBrush}"/>
                                    <Run Text="— se outro programa for instalado naquele mesmo caminho, ele herda a permissão de rede sem passar por você."/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="Por segurança, o Renova não varre CLSID em massa, fontes nem Shared DLLs — é exatamente onde os otimizadores de mercado quebram instalações."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Todas" Style="{StaticResource ChipButton}"
                                            Command="{Binding SelectAllRegistryCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Só o que importa" Style="{StaticResource ChipButton}"
                                            ToolTip="Segurança e desperdício real, ignorando resíduo cosmético"
                                            Command="{Binding SelectSecurityRegistryCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Limpar seleção" Style="{StaticResource ChipButton}"
                                            Command="{Binding ClearRegistrySelectionCommand}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                           FontSize="12.5" Foreground="{DynamicResource Fg2Brush}">
                                    <Run Text="{Binding RegistrySelectedCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="selecionada(s) ·"/>
                                    <Run Text="{Binding RegistryStatus, Mode=OneWay}"/>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Backups" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenRegistryBackupsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Analisar" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ScanRegistryCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                                    <Button Content="Remover selecionadas" Style="{StaticResource FireButton}"
                                            Command="{Binding CleanRegistryCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="3" Margin="2,0,0,8" FontSize="11.5"
                                   Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding LastRegistryBackup, Converter={StaticResource B2V}}">
                            <Run Text="Último backup:"/><Run Text="{Binding LastRegistryBackup, Mode=OneWay}"/>
                        </TextBlock>

                        <DataGrid Grid.Row="4" ItemsSource="{Binding RegistryFindings}"
                                  Style="{StaticResource DataGridBase}" IsReadOnly="False" RowHeight="52">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42" CanUserSort="False">
                                    <DataGridTemplateColumn.Header><TextBlock Text="✓" FontSize="12"/></DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Tipo" Width="105" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding SeverityColor, Converter={StaticResource Hex2B}}">
                                                <TextBlock Text="{Binding SeverityText}" Foreground="White"
                                                           FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="O que foi encontrado" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Detail}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Fg0Brush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Why}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Fg3Brush}" ToolTip="{Binding Why}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Chave" Binding="{Binding KeyPath}" Width="330" IsReadOnly="True"
                                                    FontSize="10.5"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 13 · PRÉ-REQUISITOS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Pré-requisitos" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}"
                                       Text="Cmdlets e módulos que o Renova usa. O que puder ser instalado, ele instala; o que depender da edição do Windows, ele avisa e desliga a função correspondente em vez de falhar em silêncio."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrereqSummary}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg0Brush}"/>
                                    <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Fg3Brush}">
                                        <Run Text="Instaláveis pelo Renova: provedor NuGet, PSGallery e PSWindowsUpdate."/>
                                        <Run Text="Winget precisa vir da Microsoft Store."/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Verificar" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CheckPrerequisitesCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0"/>
                                    <Button Content="Instalar o que falta" Style="{StaticResource FireButton}"
                                            Command="{Binding InstallPrerequisitesCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding Prerequisites}"
                                  Style="{StaticResource DataGridBase}" IsReadOnly="True" RowHeight="54">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Estado" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding StatusColor, Converter={StaticResource Hex2B}}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="#0A1410"
                                                           FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Componente" Width="290">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Fg0Brush}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource Fg3Brush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Usado por" Binding="{Binding UsedBy}" Width="*"/>
                                <DataGridTextColumn Header="Como resolver" Binding="{Binding FixHint}" Width="330" FontSize="10.5"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 13 - REPORTAR PROBLEMA -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Reportar um problema" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource SectionSubtitle}"
                                       Text="Monta um pacote com a sua descrição, as imagens do problema e o diagnóstico técnico da máquina. Nada é enviado automaticamente — o arquivo fica no seu disco e você decide se compartilha."/>

                            <!-- ===== Evidência (obrigatória) ===== -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Imagens do problema" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="OBRIGATÓRIO" FontSize="9.5" FontWeight="Bold"
                                                           Margin="8,1,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CardCaption}" Margin="0,3,0,0"
                                                       Text="Use Win+Shift+S para recortar a tela e clique em Colar. Um print vale mais que três parágrafos de descrição."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Colar da área de transferência" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding PasteReportImageCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Escolher arquivos" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding AddReportImagesCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Estado vazio -->
                                    <Border Background="{DynamicResource Bg2Brush}" CornerRadius="8" Padding="28"
                                            Visibility="{Binding ReportAttachments.Count, Converter={StaticResource Cnt2V}, ConverterParameter=inv}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="◲" FontSize="30" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                            <TextBlock Text="Nenhuma imagem anexada" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,8,0,2" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fg2Brush}"/>
                                            <TextBlock Text="O envio fica bloqueado até você anexar pelo menos uma."
                                                       FontSize="11.5" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Miniaturas -->
                                    <ItemsControl ItemsSource="{Binding ReportAttachments}"
                                                  Visibility="{Binding ReportAttachments.Count, Converter={StaticResource Cnt2V}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Bg2Brush}" CornerRadius="8"
                                                        Margin="0,0,10,10" Padding="8" Width="200">
                                                    <StackPanel>
                                                        <Border CornerRadius="5" ClipToBounds="True" Height="112"
                                                                Background="{DynamicResource Bg0Brush}">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,7,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Fg1Brush}"/>
                                                        <Grid Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                                            <Button Content="Remover" Style="{StaticResource ChipButton}"
                                                                    HorizontalAlignment="Right" Padding="8,3" FontSize="10"
                                                                    Command="{Binding DataContext.RemoveReportImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ===== Descrição ===== -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Título" Style="{StaticResource CardTitle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,14" Padding="9,7"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="O que aconteceu" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="OBRIGATÓRIO" FontSize="9.5" FontWeight="Bold"
                                                   Margin="8,1,0,0" Foreground="{DynamicResource DangerBrush}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding ReportDescription, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                                             VerticalScrollBarVisibility="Auto" Padding="9,7" Margin="0,0,0,14"/>

                                    <TextBlock Text="Passos para reproduzir (opcional)" Style="{StaticResource CardTitle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ReportSteps, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                             VerticalScrollBarVisibility="Auto" Padding="9,7" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Módulo afetado" Style="{StaticResource CardTitle}" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding ReportModules}"
                                                      SelectedItem="{Binding ReportModule}" Padding="8,6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Severidade" Style="{StaticResource CardTitle}" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding ReportSeverities}"
                                                      SelectedItem="{Binding ReportSeverity}" Padding="8,6"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="Acontece sempre" VerticalAlignment="Bottom"
                                                  Margin="0,0,0,8" Foreground="{DynamicResource Fg1Brush}"
                                                  IsChecked="{Binding ReportReproducible}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===== O que vai no pacote ===== -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="O que vai junto no pacote" Style="{StaticResource CardTitle}" Margin="0,0,0,7"/>
                                    <TextBlock Style="{StaticResource CardCaption}" FontSize="12" LineHeight="19" TextWrapping="Wrap">
                                        Versão do Renova, build do Windows, memória, arquitetura, se está rodando
                                        como administrador, e as últimas 150 linhas do log.
                                        <LineBreak/><LineBreak/>
                                        <Run Text="Tudo passa por sanitização antes de gravar:" FontWeight="SemiBold"/>
                                        seu nome de usuário, o nome da máquina, e-mails, endereços IP, chaves de
                                        produto e tokens são substituídos por marcadores. Isso vale inclusive para
                                        o texto que você digitar — se colar um caminho sem perceber, ele é mascarado.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ===== Envio ===== -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Publicar no GitHub" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Abrir o issue no GitHub ao gerar" Margin="0,0,0,10"
                                              Foreground="{DynamicResource Fg1Brush}"
                                              IsChecked="{Binding ReportOpenIssue}"/>
                                    <TextBlock Style="{StaticResource CardCaption}" FontSize="11.5" LineHeight="18" TextWrapping="Wrap">
                                        <Run Text="O Renova não publica nada sozinho." FontWeight="SemiBold"/>
                                        <Run Text="Ele abre no navegador um issue já preenchido no repositório do Renova e o Explorer com o .zip selecionado. Você arrasta o arquivo para o issue, revisa e clica em Submit."/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="O issue é público." FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                        <Run Text="O texto e o log são mascarados, mas as imagens não: confira se nenhum print mostra dado pessoal antes de publicar. É preciso ter uma conta gratuita no GitHub."/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="Nenhuma senha ou token fica embutido no aplicativo." FontWeight="SemiBold"
                                             Foreground="{DynamicResource SuccessBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ===== Ações ===== -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                                   Text="{Binding ReportBlockReason}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Pasta de reports" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding OpenReportsFolderCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Reabrir issue" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding IssueLastReportCommand}" Margin="0,0,8,0"
                                                    Visibility="{Binding LastReportPath, Converter={StaticResource B2V}}"/>
                                            <Button Content="Limpar" Style="{StaticResource ChipButton}"
                                                    Command="{Binding ClearReportCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Gerar e enviar" Style="{StaticResource FireButton}"
                                                    Command="{Binding SubmitReportCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding ReportStatus}" FontSize="12" Margin="0,12,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               Visibility="{Binding LastReportPath, Converter={StaticResource B2V}}">
                                        <Run Text="Último pacote:"/><Run Text="{Binding LastReportPath, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 14 - LOGS -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Logs" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Registro completo das operações. Também gravado em disco, com rotação diária."
                                       Style="{StaticResource SectionSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Row="1" Content="Abrir pasta de logs" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Command="{Binding OpenLogsFolderCommand}"/>
                        <Border Grid.Row="2" Background="{DynamicResource LogBgBrush}"
                                BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14" x:Name="LogScroll">
                                <ItemsControl ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11.5" Foreground="#8FB5A2" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ================= RODAPÉ ================= -->
            <Border Grid.Row="4" Background="{DynamicResource Bg1Brush}" Padding="20,9" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Fg3Brush}"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Fg3Brush}" FontSize="11"
                               Text="{Binding RodapeVersao, Mode=OneTime}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
                              MENU LATERAL (ESQUERDA)
             ============================================================ -->
        <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}"
                BorderBrush="{DynamicResource Bg2Brush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Marca -->
                <Border Grid.Row="0" Padding="16,20,16,14">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/Renova.ico" Width="34" Height="34" Margin="0,0,11,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Renova" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg0Brush}"/>
                            <TextBlock Text="{Binding VersaoApp, Mode=OneTime, StringFormat=versão {0}}" FontSize="10.5" Foreground="{DynamicResource Fg3Brush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="◈" Content="Painel"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=0, Mode=TwoWay}"/>

                        <TextBlock Text="SEGURANÇA" Style="{StaticResource NavGroupHeader}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚠" Content="Vulnerabilidades"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=1, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⭳" Content="Windows Update"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=2, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="◎" Content="Catálogo Microsoft"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=3, Mode=TwoWay}"/>

                        <TextBlock Text="LIMPEZA" Style="{StaticResource NavGroupHeader}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="✧" Content="Limpeza de disco"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=4, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⛃" Content="Regras da comunidade"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=10, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚿" Content="Registro do Windows"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=11, Mode=TwoWay}"/>

                        <TextBlock Text="DESEMPENHO" Style="{StaticResource NavGroupHeader}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="▤" Content="Memória RAM"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=5, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⛁" Content="Discos"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=6, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⏻" Content="Inicialização"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=7, Mode=TwoWay}"/>

                        <TextBlock Text="SISTEMA" Style="{StaticResource NavGroupHeader}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="▣" Content="Aplicativos"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=8, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="◐" Content="Varredura ao vivo"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=9, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚙" Content="Pré-requisitos"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=12, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="⚑" Content="Reportar problema"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=13, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="☰" Content="Logs"
                                     IsChecked="{Binding SelectedSection, Converter={StaticResource Idx}, ConverterParameter=14, Mode=TwoWay}"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="14,12" BorderBrush="{DynamicResource Bg2Brush}" BorderThickness="0,1,0,0">
                    <Button Content="Alternar tema claro / escuro" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Command="{Binding ToggleThemeCommand}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             OVERLAY DE CORREÇÃO — animação enquanto aplica patches
             ============================================================ -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding IsApplyingFixes, Converter={StaticResource B2V}}">
            <Rectangle Fill="{DynamicResource Bg0Brush}" Opacity="0.88"/>

            <Border Style="{StaticResource CardBorder}" Padding="46,38"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Anéis concêntricos girando em sentidos opostos -->
                    <Grid Width="130" Height="130" Margin="0,0,0,26">
                        <Ellipse Width="130" Height="130" Stroke="{DynamicResource Bg2Brush}" StrokeThickness="3"/>

                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="R1" Angle="0"/></Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Grid.Loaded">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="R1" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 65 3 A 62 62 0 0 1 127 65"/>
                        </Grid>

                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="R2" Angle="0"/></Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Grid.Loaded">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="R2" Storyboard.TargetProperty="Angle"
                                                         From="360" To="0" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Path Stroke="{DynamicResource AccentAltBrush}" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 65 18 A 47 47 0 0 1 112 65"/>
                        </Grid>

                        <!-- Núcleo pulsante -->
                        <Ellipse Width="34" Height="34" Fill="{DynamicResource BrandGradient}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleX"
                                                         From="0.75" To="1.15" Duration="0:0:0.85"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleY"
                                                         From="0.75" To="1.15" Duration="0:0:0.85"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="Aplicando correções" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource Fg0Brush}" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding CurrentFixTarget}" FontSize="13.5" Margin="0,8,0,0"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Margin="0,16,0,8" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Fg2Brush}">
                        <Run Text="{Binding FixesDone, Mode=OneWay}" FontWeight="Bold" FontSize="17"
                             Foreground="{DynamicResource Fg0Brush}"/>
                        <Run Text="de"/>
                        <Run Text="{Binding FixesTotal, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="concluídas"/>
                    </TextBlock>

                    <ProgressBar Width="340" Height="8" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"/>

                    <TextBlock Text="Não desligue o computador durante este processo."
                               FontSize="11.5" Margin="0,18,0,14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Fg3Brush}"/>

                    <Button Content="Cancelar" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Center" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
